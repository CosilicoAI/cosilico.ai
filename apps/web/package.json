{
  "name": "@cosilico/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "predev": "bun run generate:microplex-snapshot && bun run generate:microplex-observatory-db",
    "dev": "next dev --turbopack",
    "prebuild": "bun run generate:microplex-snapshot && bun run generate:microplex-observatory-db",
    "build": "next build",
    "generate:microplex-snapshot": "bun scripts/generate-microplex-snapshot.ts",
    "generate:microplex-observatory-db": "node scripts/build-microplex-observatory-db.mjs",
    "generate:policyengine-local-diagnostics": "node scripts/generate-policyengine-local-diagnostics.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test:layout": "playwright test tests/home-layout.spec.ts"
  },
  "dependencies": {
    "@cosilico/config": "workspace:*",
    "@tabler/icons-react": "^3.41.1",
    "motion": "^12",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7"
  }
}
